# Copy this file to .env and fill in real values.
# NEVER commit .env or show it on stream.
# Works next to CazIsABot.exe — edit and restart, no rebuild needed.

# --- Required ---
# Twitch application credentials (https://dev.twitch.tv/console)
APP_ID=
APP_SECRET=

# Channel login name (lowercase, no #)
TARGET_CHANNEL=

# OBS WebSocket (OBS -> Tools -> WebSocket Server Settings)
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# Create missing OBS browser sources on startup (true/false)
AUTO_CREATE_OBS_SOURCES=true

# --- Preferences (all optional) ---
# First chat of the stream fireworks celebration
FIRST_CHATTER_ENABLED=true

# Where bot audio plays: local | browser | both
AUDIO_ROUTING_MODE=local

# Skip current heavy reward: f8, f9, ctrl+shift+s, or blank to disable
SKIP_REWARD_HOTKEY=f8

# TTS caption box (BotText)
TTS_TEXT_ANCHOR=bottom
TTS_TEXT_OFFSET_X=0
TTS_TEXT_OFFSET_Y=64
TTS_TEXT_BOX_WIDTH_PX=900
TTS_TEXT_BOX_HEIGHT_PX=220
TTS_TEXT_FONT_SIZE=44
TTS_TEXT_MAX_WIDTH_PERCENT=70

# Flashbang timing / volume
FLASHBANG_HOLD_SECONDS=1.0
FLASHBANG_FADE_SECONDS=5.0
FLASHBANG_LOCAL_VOLUME=1.0
FLASHBANG_BROWSER_VOLUME=1.0
FLASHBANG_WEBCAM_GAMMA_BOOST=0.12

# OBS source names (must match your scene exactly)
# OBS_WEBCAM_SOURCE=Webcam
# OBS_TTS_SOURCE=Bot
# OBS_TTS_TEXT_SOURCE=BotText
# OBS_OVERLAY_SOURCE=RewardOverlay
# OBS_WEBCAM_COLOR_CORRECTION_FILTER=Colour Correction

# Optional hosted audio bridge
HOSTED_AUDIO_API_KEY=
